# Copy to .env (never commit .env). Real environment variables override this file.

# Your IBI NextGen login, the same as on https://ibi.orbisfn.io
IBI_USER=
IBI_PASS=

# Better than a plain password: a command that prints it. Used when IBI_PASS is empty.
# IBI_PASS_CMD=security find-generic-password -s ibi-portfolio-mcp -a me -w

# 1 = open a visible browser window (needed if IBI asks for an SMS code)
# IBI_HEADED=0
# IBI_LOGIN_TIMEOUT_S=90
# IBI_CACHE_SECONDS=300

# Debug only: saves screenshots + raw JSON (they contain your balances). Delete when done.
# IBI_DEBUG_DIR=./debug
